# JobCharcha API — environment file for systemd (EnvironmentFile=).
# Copy to /etc/jobcharcha/jobcharcha-api.env on the server, fill in real values, chmod 600, then:
#   sudo systemctl restart jobcharcha-api
#
# ASP.NET Core maps "__" (double underscore) in an env var name to ":" in configuration,
# so Razorpay__KeySecret overrides the "Razorpay:KeySecret" key. In Production, user-secrets
# are NOT loaded and appsettings.Production.json ships these blank on purpose — this file is
# the only place the real secrets live on the host.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5101

# --- Database (SQL Server auth; Windows/Trusted auth cannot reach a remote box) ---
ConnectionStrings__DefaultConnection=Server=HOST,1433;Database=JobCharchaDB_V2;User Id=USER;Password=PASSWORD;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=true

# --- Auth ---
Jwt__Key=REPLACE_WITH_A_FRESH_RANDOM_STRING_AT_LEAST_32_BYTES

# --- Razorpay (LIVE) ---
# KeyId + KeySecret: Razorpay Dashboard -> Settings -> API Keys.
# A blank or wrong KeySecret makes EVERY payment fail with "Authentication failed" (HTTP 401).
Razorpay__KeyId=rzp_live_xxxxxxxxxxxxxx
Razorpay__KeySecret=xxxxxxxxxxxxxxxxxxxxxxxx
# WebhookSecret: a SEPARATE value from KeySecret — Razorpay Dashboard -> Settings -> Webhooks,
# set when you register the webhook endpoint. If it is blank or equal to KeySecret, every
# incoming Razorpay webhook is rejected at signature verification.
Razorpay__WebhookSecret=xxxxxxxxxxxxxxxxxxxxxxxx

# --- SMTP (transactional email) ---
Smtp__Host=smtp.hostinger.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__User=noreply@jobcharcha.com
Smtp__Password=REPLACE
Smtp__FromEmail=noreply@jobcharcha.com
Smtp__FromName=JobCharcha - Gujarat Jobs

# --- URLs used in emails / sitemap ---
App__FrontendBaseUrl=https://jobcharcha.com
Cors__AllowedOrigins__0=https://jobcharcha.com
Cors__AllowedOrigins__1=https://www.jobcharcha.com

# --- Watcher agent (Scraper Draft Queue "Sync Now") ---
# Only set Enabled=true once deploy/systemd/jobcharcha-watcher.{service,timer} are installed AND
# the www-data sudoers rule below is in place — see deploy/README.md "Watcher agent" section.
WatcherAgent__Enabled=true
WatcherAgent__ServiceName=jobcharcha-watcher.service
